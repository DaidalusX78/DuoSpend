rules_version = '2';

// DuoSpend Firestore Security Rules (v0.13.20)
// Paste into Firebase Console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /households/{roomId} {
      // Room codes must be at least 10 characters (cryptographically random unguessable token).
      // Devices holding the private room code can read and write allowed household ledger fields,
      // and respect an optional per-room `requireGoogleAuth` lock (satisfied by Google or Email/Password sign-in).
      allow get: if roomId.size() >= 10
        && (resource == null
            || !resource.data.get('requireGoogleAuth', false)
            || (request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'));

      allow create, update: if roomId.size() >= 10
        && (resource == null
            || !resource.data.get('requireGoogleAuth', false)
            || (request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'))
        && request.resource.data.keys().hasOnly([
          'updatedAt', 'updatedBy', 'household', 'expenses',
          'deletedExpenseIds', 'settlements', 'members', 'requireGoogleAuth'
        ]);

      allow delete: if false; // Disallow deleting shared household rooms from client
      allow list: if false; // Disallow enumerating/listing all households
    }

    // Everything else in Firestore is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
