rules_version = '2';

// DuoSpend Firestore Security Rules (v0.13.6)
// Paste into Firebase Console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /households/{roomId} {
      // Room codes must be at least 10 characters (cryptographically random unguessable token)
      // Any authorized device possessing the private room code can read and write to their household ledger
      allow get, write: if roomId.size() >= 10;
      allow list: if false; // Disallow enumerating/listing all households
    }

    // Everything else in Firestore is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
